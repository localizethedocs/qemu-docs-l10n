msgid "Changes made in the 0.13 codebase to support Debug 1.0:"
msgstr ""

#: ../../../specs/riscv-debug.rst:64
msgid "\"Add pending to icount.\""
msgstr ""

#: ../../../specs/riscv-debug.rst:65
msgid ""
"\"If version is greater than 0, then bit 20 of mcontrol6 is no longer used "
"for timing information. (Previously the bit was called mcontrol6.timing.)\""
msgstr ""
