#: ../../../specs/riscv-debug.rst:41
msgid "Debug 0.13 to 1.0 code/design changes"
msgstr ""

#: ../../../specs/riscv-debug.rst:43
msgid ""
"The effort done in QEMU version 11.2 to support Debug versions 0.13 and 1.0 "
"together was based in section 1.2.1.2 \"Incompatible Changes from 0.13 to "
"1.0\" from the ratified `1.0 spec`_.  Here's how the proposed changes in "
"that section were implemented in QEMU 11.2:"
msgstr ""

#: ../../../specs/riscv-debug.rst:48
msgid ""
"Changes that aren't applicable due to either being SBI related or not "
"present/supported in QEMU:"
msgstr ""

#: ../../../specs/riscv-debug.rst:49
msgid "\"Make haltsum0 optional if there is only one hart.\""
msgstr ""

#: ../../../specs/riscv-debug.rst:50
msgid ""
"\"System bus autoincrement only happens if an access actually takes place "
"(sbdata0).\""
msgstr ""

#: ../../../specs/riscv-debug.rst:51
msgid "\"Require debugger to poll dmactive after lowering it.\""
msgstr ""

#: ../../../specs/riscv-debug.rst:53
msgid "Already implemented in the legacy Debug 0.13 base code:"
msgstr ""

#: ../../../specs/riscv-debug.rst:54
msgid ""
"\"When a selected trigger is disabled, tdata2 and tdata3 can be written with "
"any value supported by any of the types this trigger supports.\""
msgstr ""

#: ../../../specs/riscv-debug.rst:55
msgid "\"tcontrol fields only apply to breakpoint traps, not any trap.\""
msgstr ""

#: ../../../specs/riscv-debug.rst:57
msgid "All \"hitN\" fields are hardwired 0 thus no changes made:"
msgstr ""

#: ../../../specs/riscv-debug.rst:58
msgid ""
"\"If version is greater than 0, then hit0 (previously called mcontrol6.hit) "
"now contains 0 when a trigger fires more than one instruction after the "
"instruction that matched. (This information is now reflected in hit1.)\""
msgstr ""

#: ../../../specs/riscv-debug.rst:60
msgid ""
"QEMU doesn't support encoding sizes greater than 64 bit so no change made:"
msgstr ""

#: ../../../specs/riscv-debug.rst:61
msgid ""
"\"If version is greater than 0, then the encodings of size for sizes greater "
"than 64 bit have changed.\""
msgstr ""

