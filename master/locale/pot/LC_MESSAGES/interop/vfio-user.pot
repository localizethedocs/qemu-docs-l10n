msgstr ""

#: ../../../interop/vfio-user.rst:977
msgid "VFIO region info sparse mmap fds"
msgstr ""

#: ../../../interop/vfio-user.rst:980
msgid ""
"This capability is defined when a region supports direct access by the "
"client via mmap() where different sparse mmap areas are backed by distinct "
"file descriptors in the ``SCM_RIGHTS`` ancillary data array. The server may "
"only include this capability if the client advertised ``sparse_mmap_fds`` as "
"``true`` in ``VFIO_USER_VERSION``. Capability ID "
"``VFIO_REGION_INFO_CAP_SPARSE_MMAP_FDS`` is defined as ``0x8001`` to avoid "
"clashing with kernel VFIO capabilities."
msgstr ""

