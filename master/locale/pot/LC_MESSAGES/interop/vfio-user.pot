#: ../../../interop/vfio-user.rst:1719
msgid "VFIO_DEVICE_FEATURE_DMA_LOGGING_REPORT"
msgstr ""

#: ../../../interop/vfio-user.rst:1723
msgid "``VFIO_DEVICE_FEATURE_MIGRATION``"
msgstr ""

#: ../../../interop/vfio-user.rst:1725
msgid ""
"This feature indicates that the device can support the migration API through "
"``VFIO_DEVICE_FEATURE_MIG_DEVICE_STATE``. If ``GET`` succeeds, the "
"``RUNNING`` and ``ERROR`` states are always supported. Support for "
"additional states is indicated via the flags field; at least "
"``VFIO_MIGRATION_STOP_COPY`` must be set."
msgstr ""

#: ../../../interop/vfio-user.rst:1731
msgid "There is no data field of the request message."
msgstr ""

#: ../../../interop/vfio-user.rst:1733
msgid "The data field of the reply message is structured as follows:"
