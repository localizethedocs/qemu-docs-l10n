#: ../../../interop/vfio-user.rst:1120
msgid ""
"This command message is sent by the client to the server to query for "
"information about device interrupt types. The VFIO IRQ info structure is "
"defined in ``<linux/vfio.h>`` (``struct vfio_irq_info``)."
msgstr ""

#: ../../../interop/vfio-user.rst:1137 ../../../interop/vfio-user.rst:1168
msgid "VFIO_IRQ_INFO_EVENTFD"
msgstr ""

#: ../../../interop/vfio-user.rst:1139 ../../../interop/vfio-user.rst:1170
msgid "VFIO_IRQ_INFO_MASKABLE"
msgstr ""

#: ../../../interop/vfio-user.rst:1141 ../../../interop/vfio-user.rst:1172
msgid "VFIO_IRQ_INFO_AUTOMASKED"
msgstr ""

#: ../../../interop/vfio-user.rst:1143 ../../../interop/vfio-user.rst:1174
msgid "VFIO_IRQ_INFO_NORESIZE"
msgstr ""

#: ../../../interop/vfio-user.rst:1151
msgid "*argsz* is the maximum size of the reply payload (16 bytes today)"
msgstr ""

#: ../../../interop/vfio-user.rst:1152
msgid ""
"index is the index of IRQ type being queried (e.g. "
"``VFIO_PCI_MSIX_IRQ_INDEX``)"
msgstr ""

#: ../../../interop/vfio-user.rst:1183
msgid "*flags* defines IRQ attributes:"
msgstr ""

#: ../../../interop/vfio-user.rst:1185
msgid ""
"``VFIO_IRQ_INFO_EVENTFD`` indicates the IRQ type can support server eventfd "
"signalling."
msgstr ""

#: ../../../interop/vfio-user.rst:1187
msgid ""
"``VFIO_IRQ_INFO_MASKABLE`` indicates that the IRQ type supports the ``MASK`` "
"and ``UNMASK`` actions in a ``VFIO_USER_DEVICE_SET_IRQS`` message."
msgstr ""

#: ../../../interop/vfio-user.rst:1189
msgid ""
"``VFIO_IRQ_INFO_AUTOMASKED`` indicates the IRQ type masks itself after being "
"triggered, and the client must send an ``UNMASK`` action to receive new "
"interrupts."
msgstr ""

#: ../../../interop/vfio-user.rst:1192
msgid ""
"``VFIO_IRQ_INFO_NORESIZE`` indicates ``VFIO_USER_SET_IRQS`` operations setup "
"interrupts as a set, and new sub-indexes cannot be enabled without disabling "
"the entire type."
msgstr ""

#: ../../../interop/vfio-user.rst:1195
msgid "index is the index of IRQ type being queried"
msgstr ""

#: ../../../interop/vfio-user.rst:1196
msgid "count describes the number of interrupts of the queried type."
msgstr ""

#: ../../../interop/vfio-user.rst:1201
msgid ""
"This command message is sent by the client to the server to set actions for "
"device interrupt types. The VFIO IRQ set structure is defined in ``<linux/"
"vfio.h>`` (``struct vfio_irq_set``)."
msgstr ""

#: ../../../interop/vfio-user.rst:1218
msgid "VFIO_IRQ_SET_DATA_NONE"
msgstr ""

#: ../../../interop/vfio-user.rst:1220
msgid "VFIO_IRQ_SET_DATA_BOOL"
msgstr ""

#: ../../../interop/vfio-user.rst:1222
msgid "VFIO_IRQ_SET_DATA_EVENTFD"
msgstr ""

#: ../../../interop/vfio-user.rst:1224
msgid "VFIO_IRQ_SET_ACTION_MASK"
msgstr ""

#: ../../../interop/vfio-user.rst:1226
msgid "VFIO_IRQ_SET_ACTION_UNMASK"
msgstr ""

#: ../../../interop/vfio-user.rst:1228
msgid "VFIO_IRQ_SET_ACTION_TRIGGER"
msgstr ""

#: ../../../interop/vfio-user.rst:1233
msgid "start"
msgstr ""

#: ../../../interop/vfio-user.rst:1237 ../../../interop/vfio-user.rst:1360
#: ../../../interop/vfio-user.rst:1387 ../../../interop/vfio-user.rst:1445
#: ../../../interop/vfio-user.rst:1473 ../../../interop/vfio-user.rst:1537
#: ../../../interop/vfio-user.rst:1587 ../../../interop/vfio-user.rst:1909
#: ../../../interop/vfio-user.rst:1940
msgid "data"
msgstr ""

#: ../../../interop/vfio-user.rst:1240
msgid ""
"*argsz* is the size of the VFIO IRQ set request payload, including any "
"*data* field. Note there is no reply payload, so this field differs from "
"other message types."
msgstr ""

#: ../../../interop/vfio-user.rst:1243
msgid ""
"*flags* defines the action performed on the interrupt range. The ``DATA`` "
"flags describe the data field sent in the message; the ``ACTION`` flags "
"describe the action to be performed. The flags are mutually exclusive for "
"both sets."
msgstr ""

#: ../../../interop/vfio-user.rst:1248
msgid ""
"``VFIO_IRQ_SET_DATA_NONE`` indicates there is no data field in the command. "
"The action is performed unconditionally."
msgstr ""

#: ../../../interop/vfio-user.rst:1250
msgid ""
"``VFIO_IRQ_SET_DATA_BOOL`` indicates the data field is an array of boolean "
"bytes. The action is performed if the corresponding boolean is true."
msgstr ""

#: ../../../interop/vfio-user.rst:1252
msgid ""
"``VFIO_IRQ_SET_DATA_EVENTFD`` indicates an array of event file descriptors "
"was sent in the message meta-data. These descriptors will be signalled when "
"the action defined by the action flags occurs. In ``AF_UNIX`` sockets, the "
"descriptors are sent as ``SCM_RIGHTS`` type ancillary data. If no file "
"descriptors are provided, this de-assigns the specified previously "
"configured interrupts."
msgstr ""

#: ../../../interop/vfio-user.rst:1258
msgid ""
"``VFIO_IRQ_SET_ACTION_MASK`` indicates a masking event. It can be used with "
"``VFIO_IRQ_SET_DATA_BOOL`` or ``VFIO_IRQ_SET_DATA_NONE`` to mask an "
"interrupt, or with ``VFIO_IRQ_SET_DATA_EVENTFD`` to generate an event when "
"the guest masks the interrupt."
msgstr ""

#: ../../../interop/vfio-user.rst:1262
msgid ""
"``VFIO_IRQ_SET_ACTION_UNMASK`` indicates an unmasking event. It can be used "
"with ``VFIO_IRQ_SET_DATA_BOOL`` or ``VFIO_IRQ_SET_DATA_NONE`` to unmask an "
"interrupt, or with ``VFIO_IRQ_SET_DATA_EVENTFD`` to generate an event when "
"the guest unmasks the interrupt."
msgstr ""

#: ../../../interop/vfio-user.rst:1266
msgid ""
"``VFIO_IRQ_SET_ACTION_TRIGGER`` indicates a triggering event. It can be used "
"with ``VFIO_IRQ_SET_DATA_BOOL`` or ``VFIO_IRQ_SET_DATA_NONE`` to trigger an "
"interrupt, or with ``VFIO_IRQ_SET_DATA_EVENTFD`` to generate an event when "
"the server triggers the interrupt."
msgstr ""

#: ../../../interop/vfio-user.rst:1271
msgid "*index* is the index of IRQ type being setup."
msgstr ""

#: ../../../interop/vfio-user.rst:1272
msgid "*start* is the start of the sub-index being set."
msgstr ""

#: ../../../interop/vfio-user.rst:1273
msgid ""
"*count* describes the number of sub-indexes being set. As a special case, a "
"count (and start) of 0, with data flags of ``VFIO_IRQ_SET_DATA_NONE`` "
"disables all interrupts of the index."
msgstr ""

#: ../../../interop/vfio-user.rst:1276
msgid ""
"*data* is an optional field included when the ``VFIO_IRQ_SET_DATA_BOOL`` "
"flag is present. It contains an array of booleans that specify whether the "
"action is to be performed on the corresponding index. It's used when the "
"action is only performed on a subset of the range specified."
msgstr ""

#: ../../../interop/vfio-user.rst:1282
msgid ""
"Not all interrupt types support every combination of data and action flags. "
"The client must know the capabilities of the device and IRQ index before it "
"sends a ``VFIO_USER_DEVICE_SET_IRQ`` message."
msgstr ""

#: ../../../interop/vfio-user.rst:1286
msgid "In typical operation, a specific IRQ may operate as follows:"
msgstr ""

#: ../../../interop/vfio-user.rst:1288
msgid ""
"The client sends a ``VFIO_USER_DEVICE_SET_IRQ`` message with "
"``flags=(VFIO_IRQ_SET_DATA_EVENTFD|VFIO_IRQ_SET_ACTION_TRIGGER)`` along with "
"an eventfd. This associates the IRQ with a particular eventfd on the server "
"side."
msgstr ""

#: ../../../interop/vfio-user.rst:1293
msgid ""
"The client may send a ``VFIO_USER_DEVICE_SET_IRQ`` message with "
"``flags=(VFIO_IRQ_SET_DATA_EVENTFD|VFIO_IRQ_SET_ACTION_MASK/UNMASK)`` along "
"with another eventfd. This associates the given eventfd with the mask/unmask "
"state on the server side."
msgstr ""

#: ../../../interop/vfio-user.rst:1298
msgid "The server may trigger the IRQ by writing 1 to the eventfd."
msgstr ""

#: ../../../interop/vfio-user.rst:1300
msgid ""
"The server may mask/unmask an IRQ which will write 1 to the corresponding "
"mask/unmask eventfd, if there is one."
msgstr ""

#: ../../../interop/vfio-user.rst:1303
msgid ""
"A client may trigger a device IRQ itself, by sending a "
"``VFIO_USER_DEVICE_SET_IRQ`` message with ``flags=(VFIO_IRQ_SET_DATA_NONE/"
"BOOL|VFIO_IRQ_SET_ACTION_TRIGGER)``."
msgstr ""

#: ../../../interop/vfio-user.rst:1307
msgid ""
"A client may mask or unmask the IRQ, by sending a "
"``VFIO_USER_DEVICE_SET_IRQ`` message with ``flags=(VFIO_IRQ_SET_DATA_NONE/"
"BOOL|VFIO_IRQ_SET_ACTION_MASK/UNMASK)``."
msgstr ""

#: ../../../interop/vfio-user.rst:1314
msgid "There is no payload in the reply."
msgstr ""

#: ../../../interop/vfio-user.rst:1318
msgid ""
"Note that all of these operations must be supported by the client and/or "
"server, even if the corresponding memory or device region has been shared as "
"mappable."
msgstr ""

#: ../../../interop/vfio-user.rst:1321
msgid ""
"The ``count`` field must not exceed the value of ``max_data_xfer_size`` of "
"the peer, for both reads and writes."
msgstr ""

#: ../../../interop/vfio-user.rst:1327
msgid ""
"If a device region is not mappable, it's not directly accessible by the "
"client via ``mmap()`` of the underlying file descriptor. In this case, a "
"client can read from a device region with this message."
msgstr ""

#: ../../../interop/vfio-user.rst:1339 ../../../interop/vfio-user.rst:1356
#: ../../../interop/vfio-user.rst:1383 ../../../interop/vfio-user.rst:1403
#: ../../../interop/vfio-user.rst:1533
msgid "region"
msgstr ""

#: ../../../interop/vfio-user.rst:1344 ../../../interop/vfio-user.rst:1390
#: ../../../interop/vfio-user.rst:1540
msgid "*offset* into the region being accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1345 ../../../interop/vfio-user.rst:1391
#: ../../../interop/vfio-user.rst:1541
msgid "*region* is the index of the region being accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1346 ../../../interop/vfio-user.rst:1392
#: ../../../interop/vfio-user.rst:1433 ../../../interop/vfio-user.rst:1478
msgid "*count* is the size of the data to be transferred."
msgstr ""

#: ../../../interop/vfio-user.rst:1363 ../../../interop/vfio-user.rst:1408
msgid "*offset* into the region accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1364 ../../../interop/vfio-user.rst:1409
msgid "*region* is the index of the region accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1365 ../../../interop/vfio-user.rst:1410
#: ../../../interop/vfio-user.rst:1449 ../../../interop/vfio-user.rst:1493
msgid "*count* is the size of the data transferred."
msgstr ""

#: ../../../interop/vfio-user.rst:1366
msgid "*data* is the data that was read from the device region."
msgstr ""

#: ../../../interop/vfio-user.rst:1371
msgid ""
"If a device region is not mappable, it's not directly accessible by the "
"client via mmap() of the underlying fd. In this case, a client can write to "
"a device region with this message."
msgstr ""

#: ../../../interop/vfio-user.rst:1393 ../../../interop/vfio-user.rst:1479
msgid "*data* is the data to write"
msgstr ""

#: ../../../interop/vfio-user.rst:1415
msgid ""
"If the client has not shared mappable memory, the server can use this "
"message to read from guest memory. This message and its reply are passed "
"over the separate server-to-client socket if twin-socket mode has been "
"negotiated during connection setup."
msgstr ""

#: ../../../interop/vfio-user.rst:1431 ../../../interop/vfio-user.rst:1476
msgid ""
"*address* is the client DMA memory address being accessed. This address must "
"have been previously exported to the server with a ``VFIO_USER_DMA_MAP`` "
"message."
msgstr ""

#: ../../../interop/vfio-user.rst:1448 ../../../interop/vfio-user.rst:1492
msgid "*address* is the client DMA memory address being accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1450
msgid "*data* is the data read."
msgstr ""

#: ../../../interop/vfio-user.rst:1452
msgid ""
"Note that whether short reads return an error or just set count "
"appropriately is a client-side choice; servers should be prepared to handle "
"both cases."
msgstr ""

#: ../../../interop/vfio-user.rst:1458
msgid ""
"If the client has not shared mappable memory, the server can use this "
"message to write to guest memory. This message and its reply are passed over "
"the separate server-to-client socket if twin-socket mode has been negotiated "
"during connection setup."
msgstr ""

#: ../../../interop/vfio-user.rst:1495
msgid ""
"Note that whether short writes return an error or just set count "
"appropriately is a client-side choice; servers should be prepared to handle "
"both cases."
msgstr ""

#: ../../../interop/vfio-user.rst:1501
msgid ""
"This command message is sent from the client to the server to reset the "
"device. Neither the request or reply have a payload."
msgstr ""

#: ../../../interop/vfio-user.rst:1507
msgid ""
"This message can be used to coalesce multiple device write operations into a "
"single messgage.  It is only used as an optimization when the outgoing "
"message queue is relatively full."
msgstr ""

#: ../../../interop/vfio-user.rst:1517 ../../../interop/vfio-user.rst:1552
msgid "wr_cnt"
msgstr ""

#: ../../../interop/vfio-user.rst:1519
msgid "wrs"
msgstr ""

#: ../../../interop/vfio-user.rst:1522
msgid "*wr_cnt* is the number of device writes coalesced in the message"
msgstr ""

#: ../../../interop/vfio-user.rst:1523
msgid "*wrs* is an array of device writes defined below"
msgstr ""

#: ../../../interop/vfio-user.rst:1526
msgid "Single Device Write Format"
msgstr ""

#: ../../../interop/vfio-user.rst:1542
msgid ""
"*count* is the size of the data to be transferred.  This format can only "
"describe writes of 8 bytes or less."
msgstr ""

#: ../../../interop/vfio-user.rst:1544
msgid "*data* is the data to write."
msgstr ""

#: ../../../interop/vfio-user.rst:1555
msgid "*wr_cnt* is the number of device writes completed."
msgstr ""

#: ../../../interop/vfio-user.rst:1560
msgid ""
"This command is analogous to ``VFIO_DEVICE_FEATURE``. It is used to get, "
"set, or probe feature data of the device."
msgstr ""

#: ../../../interop/vfio-user.rst:1566 ../../../interop/vfio-user.rst:1883
#: ../../../interop/vfio-user.rst:1931
msgid ""
"The request payload for this message is a structure of the following format."
msgstr ""

#: ../../../interop/vfio-user.rst:1578
msgid "0 to 15"
msgstr ""

#: ../../../interop/vfio-user.rst:1578
msgid "Feature index"
msgstr ""

#: ../../../interop/vfio-user.rst:1580
msgid "VFIO_DEVICE_FEATURE_GET"
msgstr ""

#: ../../../interop/vfio-user.rst:1582
msgid "VFIO_DEVICE_FEATURE_SET"
msgstr ""

#: ../../../interop/vfio-user.rst:1584
msgid "VFIO_DEVICE_FEATURE_PROBE"
msgstr ""

#: ../../../interop/vfio-user.rst:1592
msgid ""
"*flags* defines the action to be performed by the server and upon which "
"feature:"
msgstr ""

#: ../../../interop/vfio-user.rst:1595
msgid ""
"The feature index consists of the least significant 16 bits of the flags "
"field, and can be accessed using the ``VFIO_DEVICE_FEATURE_MASK`` bit mask."
msgstr ""

#: ../../../interop/vfio-user.rst:1598
msgid ""
"``VFIO_DEVICE_FEATURE_GET`` instructs the server to get the data for the "
"given feature."
msgstr ""

#: ../../../interop/vfio-user.rst:1601
msgid ""
"``VFIO_DEVICE_FEATURE_SET`` instructs the server to set the feature data to "
"that given in the ``data`` field of the payload."
msgstr ""

#: ../../../interop/vfio-user.rst:1604
msgid ""
"``VFIO_DEVICE_FEATURE_PROBE`` instructs the server to probe for feature "
"support. If ``VFIO_DEVICE_FEATURE_GET`` and/or ``VFIO_DEVICE_FEATURE_SET`` "
"are also set, the probe will only return success if all of the indicated "
"methods are supported."
msgstr ""

#: ../../../interop/vfio-user.rst:1609
msgid ""
"``VFIO_DEVICE_FEATURE_GET`` and ``VFIO_DEVICE_FEATURE_SET`` are mutually "
"exclusive, except for use with ``VFIO_DEVICE_FEATURE_PROBE``."
msgstr ""

#: ../../../interop/vfio-user.rst:1612
msgid ""
"*data* is specific to the particular feature. It is not used for probing."
msgstr ""

#: ../../../interop/vfio-user.rst:1614
msgid ""
"This part of the request is analogous to VFIO's ``struct "
"vfio_device_feature``."
msgstr ""

#: ../../../interop/vfio-user.rst:1619
msgid ""
"The reply payload must be the same as the request payload for setting or "
"probing a feature. For getting a feature's data, the data is added in the "
"data section and its length is added to ``argsz``."
msgstr ""

#: ../../../interop/vfio-user.rst:1624
msgid "Device Features"
msgstr ""

#: ../../../interop/vfio-user.rst:1626
msgid ""
"The only device features supported by vfio-user are those related to "
"migration, although this may change in the future. They are a subset of "
"those supported in the VFIO implementation of the Linux kernel."
msgstr ""

#: ../../../interop/vfio-user.rst:1631
msgid "Feature Index"
msgstr ""

#: ../../../interop/vfio-user.rst:1633
msgid "VFIO_DEVICE_FEATURE_MIGRATION"
msgstr ""

#: ../../../interop/vfio-user.rst:1635
msgid "VFIO_DEVICE_FEATURE_MIG_DEVICE_STATE"
msgstr ""

#: ../../../interop/vfio-user.rst:1637
msgid "VFIO_DEVICE_FEATURE_DMA_LOGGING_START"
msgstr ""

#: ../../../interop/vfio-user.rst:1639
msgid "VFIO_DEVICE_FEATURE_DMA_LOGGING_STOP"
msgstr ""

#: ../../../interop/vfio-user.rst:1641
msgid "VFIO_DEVICE_FEATURE_DMA_LOGGING_REPORT"
msgstr ""

#: ../../../interop/vfio-user.rst:1645
msgid "``VFIO_DEVICE_FEATURE_MIGRATION``"
msgstr ""

#: ../../../interop/vfio-user.rst:1647
msgid ""
"This feature indicates that the device can support the migration API through "
"``VFIO_DEVICE_FEATURE_MIG_DEVICE_STATE``. If ``GET`` succeeds, the "
"``RUNNING`` and ``ERROR`` states are always supported. Support for "
"additional states is indicated via the flags field; at least "
"``VFIO_MIGRATION_STOP_COPY`` must be set."
msgstr ""

#: ../../../interop/vfio-user.rst:1653
msgid "There is no data field of the request message."
msgstr ""

#: ../../../interop/vfio-user.rst:1655
msgid "The data field of the reply message is structured as follows:"
msgstr ""

#: ../../../interop/vfio-user.rst:1665
msgid "VFIO_MIGRATION_STOP_COPY"
msgstr ""

#: ../../../interop/vfio-user.rst:1667
msgid "VFIO_MIGRATION_P2P"
msgstr ""

#: ../../../interop/vfio-user.rst:1669
msgid "VFIO_MIGRATION_PRE_COPY"
msgstr ""

#: ../../../interop/vfio-user.rst:1673
msgid "These flags are interpreted in the same way as VFIO."
msgstr ""

#: ../../../interop/vfio-user.rst:1676
msgid "``VFIO_DEVICE_FEATURE_MIG_DEVICE_STATE``"
msgstr ""

#: ../../../interop/vfio-user.rst:1678
msgid ""
"Upon ``VFIO_DEVICE_FEATURE_SET``, execute a migration state change on the "
"VFIO device. The new state is supplied in ``device_state``. The state "
"transition must fully complete before the reply is sent."
msgstr ""

#: ../../../interop/vfio-user.rst:1682
msgid ""
"The data field of the reply message, as well as the ``SET`` request message, "
"is structured as follows:"
msgstr ""

#: ../../../interop/vfio-user.rst:1688
msgid "device_state"
msgstr ""

#: ../../../interop/vfio-user.rst:1690
msgid "data_fd"
msgstr ""

#: ../../../interop/vfio-user.rst:1693
msgid ""
"*device_state* is the current state of the device (for ``GET``) or the state "
"to transition to (for ``SET``). It is defined by the "
"``vfio_device_mig_state`` enum as detailed below. These states are the "
"states of the device migration Finite State Machine."
msgstr ""

#: ../../../interop/vfio-user.rst:1699
msgid "State"
msgstr ""

#: ../../../interop/vfio-user.rst:1701
msgid "VFIO_DEVICE_STATE_ERROR"
msgstr ""

#: ../../../interop/vfio-user.rst:1701
msgid "The device has failed and must be reset."
msgstr ""

#: ../../../interop/vfio-user.rst:1703
msgid "VFIO_DEVICE_STATE_STOP"
msgstr ""

#: ../../../interop/vfio-user.rst:1703
msgid "The device does not change the internal or external state."
msgstr ""

#: ../../../interop/vfio-user.rst:1705
msgid "VFIO_DEVICE_STATE_RUNNING"
msgstr ""

#: ../../../interop/vfio-user.rst:1705
msgid "The device is running normally."
msgstr ""

#: ../../../interop/vfio-user.rst:1707
msgid "VFIO_DEVICE_STATE_STOP_COPY"
msgstr ""

#: ../../../interop/vfio-user.rst:1707
msgid "The device internal state can be read out."
msgstr ""

#: ../../../interop/vfio-user.rst:1709
msgid "VFIO_DEVICE_STATE_RESUMING"
msgstr ""

#: ../../../interop/vfio-user.rst:1709
msgid "The device is stopped and is loading a new internal state."
msgstr ""

#: ../../../interop/vfio-user.rst:1711
msgid "VFIO_DEVICE_STATE_RUNNING_P2P"
msgstr ""

#: ../../../interop/vfio-user.rst:1711 ../../../interop/vfio-user.rst:1715
msgid "(not used in vfio-user)"
msgstr ""

#: ../../../interop/vfio-user.rst:1713
msgid "VFIO_DEVICE_STATE_PRE_COPY"
msgstr ""

#: ../../../interop/vfio-user.rst:1713
msgid "The device is running normally but tracking internal state changes."
msgstr ""

#: ../../../interop/vfio-user.rst:1715
msgid "VFIO_DEVICE_STATE_PRE_COPY_P2P"
msgstr ""

#: ../../../interop/vfio-user.rst:1718
msgid ""
"*data_fd* is unused in vfio-user, as the ``VFIO_USER_MIG_DATA_READ`` and "
"``VFIO_USER_MIG_DATA_WRITE`` messages are used instead for migration data "
"transport."
msgstr ""

#: ../../../interop/vfio-user.rst:1723
msgid "Direct State Transitions"
msgstr ""

#: ../../../interop/vfio-user.rst:1725
msgid ""
"The device migration FSM is a Mealy machine, so actions are taken upon the "
"arcs between FSM states. The following transitions need to be supported by "
"the server, a subset of those defined in ``<linux/vfio.h>`` (``enum "
"vfio_device_mig_state``)."
msgstr ""

#: ../../../interop/vfio-user.rst:1730
msgid ""
"``RUNNING -> STOP``, ``STOP_COPY -> STOP``: Stop the operation of the "
"device. The ``STOP_COPY`` arc terminates the data transfer session."
msgstr ""

#: ../../../interop/vfio-user.rst:1733
msgid ""
"``RESUMING -> STOP``: Terminate the data transfer session. Complete "
"processing of the migration data. Stop the operation of the device. If the "
"delivered data is found to be incomplete, inconsistent, or otherwise "
"invalid, fail the ``SET`` command and optionally transition to the ``ERROR`` "
"state."
msgstr ""

#: ../../../interop/vfio-user.rst:1738
msgid ""
"``PRE_COPY -> RUNNING``: Terminate the data transfer session. The device is "
"now fully operational."
msgstr ""

#: ../../../interop/vfio-user.rst:1741
msgid "``STOP -> RUNNING``: Start the operation of the device."
msgstr ""

#: ../../../interop/vfio-user.rst:1743
msgid ""
"``RUNNING -> PRE_COPY``, ``STOP -> STOP_COPY``: Begin the process of saving "
"the device state. The device operation is unchanged, but data transfer "
"begins. ``PRE_COPY`` and ``STOP_COPY`` are referred to as the \"saving "
"group\" of states."
msgstr ""

#: ../../../interop/vfio-user.rst:1748
msgid ""
"``PRE_COPY -> STOP_COPY``: Continue to transfer migration data, but stop "
"device operation."
msgstr ""

#: ../../../interop/vfio-user.rst:1751
msgid ""
"``STOP -> RESUMING``: Start the process of restoring the device state. The "
"internal device state may be changed to prepare the device to receive the "
"migration data."
msgstr ""

#: ../../../interop/vfio-user.rst:1755
msgid ""
"The ``STOP_COPY -> PRE_COPY`` transition is explicitly not allowed and "
"should return an error if requested."
msgstr ""

#: ../../../interop/vfio-user.rst:1758
msgid ""
"``ERROR`` cannot be specified as a device state, but any transition request "
"can be failed and then move the state into ``ERROR`` if the server was "
"unable to execute the requested arc AND was unable to restore the device "
"into any valid state. To recover from ``ERROR``, ``VFIO_USER_DEVICE_RESET`` "
"must be used to return back to ``RUNNING``."
msgstr ""

#: ../../../interop/vfio-user.rst:1764
msgid "If ``PRE_COPY`` is not supported, arcs touching it are removed."
msgstr ""

#: ../../../interop/vfio-user.rst:1767
msgid "Complex State Transitions"
msgstr ""

#: ../../../interop/vfio-user.rst:1769
msgid ""
"The remaining possible transitions are to be implemented as combinations of "
"the above FSM arcs. As there are multiple paths, the path should be selected "
"based on the following rules:"
msgstr ""

#: ../../../interop/vfio-user.rst:1773
msgid "Select the shortest path."
msgstr ""

#: ../../../interop/vfio-user.rst:1775
msgid ""
"The path cannot have saving group states as interior arcs, only start/end "
"states."
msgstr ""

#: ../../../interop/vfio-user.rst:1779
msgid ""
"``VFIO_DEVICE_FEATURE_DMA_LOGGING_START`` / "
"``VFIO_DEVICE_FEATURE_DMA_LOGGING_STOP``"
msgstr ""

#: ../../../interop/vfio-user.rst:1781
msgid ""
"Upon ``VFIO_DEVICE_FEATURE_SET``, start/stop DMA logging. These features can "
"also be probed to determine whether the device supports DMA logging."
msgstr ""

#: ../../../interop/vfio-user.rst:1784
msgid ""
"When DMA logging is started, a range of IOVAs to monitor is provided and the "
"device can optimize its logging to cover only the IOVA range given. Only DMA "
"writes are logged."
msgstr ""

#: ../../../interop/vfio-user.rst:1788
msgid "The data field of the ``SET`` request is structured as follows:"
msgstr ""

#: ../../../interop/vfio-user.rst:1793 ../../../interop/vfio-user.rst:1843
msgid "page_size"
msgstr ""

#: ../../../interop/vfio-user.rst:1795
msgid "num_ranges"
msgstr ""

#: ../../../interop/vfio-user.rst:1799
msgid "ranges"
msgstr ""

#: ../../../interop/vfio-user.rst:1802
msgid ""
"*page_size* hints what tracking granularity the device should try to "
"achieve. If the device cannot do the hinted page size then it's the driver's "
"choice which page size to pick based on its support. On output the device "
"will return the page size it selected."
msgstr ""

#: ../../../interop/vfio-user.rst:1807
msgid ""
"*num_ranges* is the number of IOVA ranges to monitor. A value of zero "
"indicates that all writes should be logged."
msgstr ""

#: ../../../interop/vfio-user.rst:1810
msgid ""
"*ranges* is an array of ``vfio_user_device_feature_dma_logging_range`` "
"entries:"
msgstr ""

#: ../../../interop/vfio-user.rst:1816 ../../../interop/vfio-user.rst:1839
msgid "iova"
msgstr ""

#: ../../../interop/vfio-user.rst:1818 ../../../interop/vfio-user.rst:1841
msgid "length"
msgstr ""

#: ../../../interop/vfio-user.rst:1821 ../../../interop/vfio-user.rst:1846
msgid "*iova* is the base IO virtual address"
msgstr ""

#: ../../../interop/vfio-user.rst:1822
msgid "*length* is the length of the range to log"
msgstr ""

#: ../../../interop/vfio-user.rst:1824
msgid ""
"Upon success, the response data field will be the same as the request, "
"unless the page size was changed, in which case this will be reflected in "
"the response."
msgstr ""

#: ../../../interop/vfio-user.rst:1828
msgid "``VFIO_DEVICE_FEATURE_DMA_LOGGING_REPORT``"
msgstr ""

#: ../../../interop/vfio-user.rst:1830
msgid ""
"Upon ``VFIO_DEVICE_FEATURE_GET``, returns the dirty bitmap for a specific "
"IOVA range. This operation is only valid if logging of dirty pages has been "
"previously started by setting ``VFIO_DEVICE_FEATURE_DMA_LOGGING_START``."
msgstr ""

#: ../../../interop/vfio-user.rst:1834
msgid "The data field of the request is structured as follows:"
msgstr ""

#: ../../../interop/vfio-user.rst:1848
msgid "*length* is the length of the range"
msgstr ""

#: ../../../interop/vfio-user.rst:1850
msgid ""
"*page_size* is the unit of granularity of the bitmap, and must be a power of "
"two. It doesn't have to match the value given to "
"``VFIO_DEVICE_FEATURE_DMA_LOGGING_START`` because the driver will format its "
"internal logging to match the reporting page size possibly by replicating "
"bits if the internal page size is lower than requested"
msgstr ""

#: ../../../interop/vfio-user.rst:1856
msgid ""
"The data field of the response is identical, except with the bitmap added on "
"the end at offset 24."
msgstr ""

#: ../../../interop/vfio-user.rst:1859
msgid ""
"The bitmap is an array of u64s that holds the output bitmap, with 1 bit "
"reporting a *page_size* unit of IOVA. The bits outside of the requested "
"range must be zero."
msgstr ""

#: ../../../interop/vfio-user.rst:1863
msgid "The mapping of IOVA to bits is given by:"
msgstr ""

#: ../../../interop/vfio-user.rst:1865
msgid "``bitmap[(addr - iova)/page_size] & (1ULL << (addr % 64))``"
msgstr ""

#: ../../../interop/vfio-user.rst:1870
msgid ""
"This command is used to read data from the source migration server while it "
"is in a saving group state (``PRE_COPY`` or ``STOP_COPY``)."
msgstr ""

#: ../../../interop/vfio-user.rst:1873
msgid ""
"This command, and ``VFIO_USER_MIG_DATA_WRITE``, are used in place of the "
"``data_fd`` file descriptor in ``<linux/vfio.h>`` (``struct "
"vfio_device_feature_mig_state``) to enable all data transport to use the "
"single already-established UNIX socket. Hence, the migration data is treated "
"like a stream, so the client must continue reading until no more migration "
"data remains."
msgstr ""

#: ../../../interop/vfio-user.rst:1895
msgid "*size* is the size of the migration data to read."
msgstr ""

#: ../../../interop/vfio-user.rst:1900
msgid ""
"The reply payload for this message is a structure of the following format."
msgstr ""

#: ../../../interop/vfio-user.rst:1912
msgid ""
"*argsz* is the size of the above structure, including the size of the data."
msgstr ""

#: ../../../interop/vfio-user.rst:1914
msgid ""
"*size* indicates the size of returned migration data. If this is less than "
"the requested size, there is no more migration data to read."
msgstr ""

#: ../../../interop/vfio-user.rst:1917 ../../../interop/vfio-user.rst:1947
msgid "*data* contains the migration data."
msgstr ""

#: ../../../interop/vfio-user.rst:1922
msgid ""
"This command is used to write data to the destination migration server while "
"it is in the ``RESUMING`` state."
msgstr ""

#: ../../../interop/vfio-user.rst:1925
msgid ""
"As above, this replaces the ``data_fd`` file descriptor for transport of "
"migration data, and as such, the migration data is treated like a stream."
msgstr ""

#: ../../../interop/vfio-user.rst:1945
msgid "*size* is the size of the migration data to be written."
msgstr ""

#: ../../../interop/vfio-user.rst:1952
msgid "There is no reply payload for this message."
msgstr ""

