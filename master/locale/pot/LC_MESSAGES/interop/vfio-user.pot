msgstr ""

#: ../../../interop/vfio-user.rst:1422 ../../../interop/vfio-user.rst:1468
#: ../../../interop/vfio-user.rst:1618
msgid "*offset* into the region being accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1423 ../../../interop/vfio-user.rst:1469
#: ../../../interop/vfio-user.rst:1619
msgid "*region* is the index of the region being accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1424 ../../../interop/vfio-user.rst:1470
#: ../../../interop/vfio-user.rst:1511 ../../../interop/vfio-user.rst:1556
msgid "*count* is the size of the data to be transferred."
msgstr ""

#: ../../../interop/vfio-user.rst:1441 ../../../interop/vfio-user.rst:1486
msgid "*offset* into the region accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1442 ../../../interop/vfio-user.rst:1487
msgid "*region* is the index of the region accessed."
msgstr ""

#: ../../../interop/vfio-user.rst:1443 ../../../interop/vfio-user.rst:1488
#: ../../../interop/vfio-user.rst:1527 ../../../interop/vfio-user.rst:1571
msgid "*count* is the size of the data transferred."
msgstr ""

#: ../../../interop/vfio-user.rst:1444
msgid "*data* is the data that was read from the device region."
msgstr ""

#: ../../../interop/vfio-user.rst:1449
msgid ""
"If a device region is not mappable, it's not directly accessible by the "
"client via mmap() of the underlying fd. In this case, a client can write to "
"a device region with this message."
msgstr ""

#: ../../../interop/vfio-user.rst:1471 ../../../interop/vfio-user.rst:1557
msgid "*data* is the data to write"
msgstr ""

#: ../../../interop/vfio-user.rst:1493
msgid ""
"If the client has not shared mappable memory, the server can use this "
"message to read from guest memory. This message and its reply are passed "
"over the separate server-to-client socket if twin-socket mode has been "
"negotiated during connection setup."
msgstr ""

#: ../../../interop/vfio-user.rst:1509 ../../../interop/vfio-user.rst:1554
msgid ""
"*address* is the client DMA memory address being accessed. This address must "
"have been previously exported to the server with a ``VFIO_USER_DMA_MAP`` "
"message."
msgstr ""

#: ../../../interop/vfio-user.rst:1526 ../../../interop/vfio-user.rst:1570
